# Переменные окружения docker compose: файл .env (cp .env.example .env) или переменные платформы деплоя.
# Файл .env не коммитится. Без .env стек тоже поднимается: сайт и API работают, бот ждёт MAX_BOT_TOKEN.

# Порт сайта на хосте (http://localhost:8080)
WEB_PORT=8080

# MAX: токен и ник бота из кабинета платформы MAX для партнёров
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
# Публичный HTTPS-адрес сайта: мини-приложение и ссылки на форму отзыва.
WEB_APP_URL=
# strict — только подписанный initData мини-приложения; optional — для локальной разработки в браузере.
MAX_WEBAPP_AUTH=strict
# Адрес MAX Bot API. platform-api2.max.ru подписан сертификатом Минцифры, которому Node по умолчанию не доверяет.
MAX_API_BASE_URL=https://platform-api.max.ru

# Хранилище файлов: s3 (Yandex Object Storage, Selectel, MinIO…) или local (том barber-data).
# Пусто — s3, если задан S3_BUCKET, иначе local.
STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=

# Прочее
MAX_HOMEWORK_UPLOAD_MB=450
CHAT_ENABLED=true
# Демо-режим для жюри: вход по ролям, демо-академия и эмулятор событий.
DEMO_MODE=false
# Необязательно: анонимизированный снимок демо-академии (JSON) вместо синтетических данных.
DEMO_SNAPSHOT_PATH=
APP_NOTIFICATIONS_RETENTION_DAYS=90
